# Mẫu thiết lập kết nối này public trên github, bạn có thể thay đổi các giá trị bên dưới để kết nối với cơ sở dữ liệu của riêng bạn.

# Database
DB_HOST=your-supabase-host.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_NAME=postgres
DB_SSLMODE=require

# Hoặc connection string:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@your-host.supabase.co:5432/postgres?sslmode=require

# Server
SERVER_PORT=8080